@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(POLICY CMP0144)
    cmake_policy(SET CMP0144 NEW)
endif()
if(POLICY CMP0167)
    cmake_policy(SET CMP0167 OLD)
endif()
find_dependency(Boost 1.84)
find_dependency(Threads)
find_dependency(OpenSSL 3 COMPONENTS SSL Crypto)

include("${CMAKE_CURRENT_LIST_DIR}/ZZUAssistantTargets.cmake")
check_required_components(ZZUAssistant)
